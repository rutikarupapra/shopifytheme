{%- comment -%}
  LumaShop inline icons. Usage: {% render 'lumashop-icon', name: 'truck' %}
  Icons use currentColor, so the color is controlled from CSS / section settings.
{%- endcomment -%}
<svg class="lm-icon lm-icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
    {%- when 'cart' -%}<path d="M3 4h2.5l2.2 11h10.1l2-8H6.3"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/>
    {%- when 'bag' -%}<path d="M5 8h14l1 12H4L5 8Z"/><path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"/><path d="M9.5 13.5c.7 1 1.4 1.5 2.5 1.5s1.8-.5 2.5-1.5"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>
    {%- when 'star' -%}<path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.8 6.2.9-4.5 4.4 1.1 6.2L12 17.1l-5.6 3 1.1-6.2L3 9.5l6.2-.9L12 2.8Z"/>
    {%- when 'chevron-left' -%}<path d="m15 5-7 7 7 7"/>
    {%- when 'chevron-right' -%}<path d="m9 5 7 7-7 7"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.3 2.3 4.1-4.3"/>
    {%- when 'headset' -%}<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.5-1.8 2.5-5 2.5"/>
    {%- when 'gift' -%}<rect x="3.5" y="9" width="17" height="4"/><path d="M5 13v7.5h14V13M12 9v11.5M12 9S10.5 4 8 4.5 8 9 12 9Zm0 0s1.5-5 4-4.5S16 9 12 9Z"/>
    {%- when 'return' -%}<path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/>
    {%- when 'sparkle' -%}<path fill="currentColor" stroke="none" d="M12 2c.6 4.5 2.5 6.4 7 7-4.5.6-6.4 2.5-7 7-.6-4.5-2.5-6.4-7-7 4.5-.6 6.4-2.5 7-7Z"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'send' -%}<path d="M21 3 10 14M21 3l-6.5 18-4-7-7-4L21 3Z"/>
    {%- when 'facebook' -%}<circle cx="12" cy="12" r="9.5" fill="currentColor" stroke="none"/><path stroke="var(--lm-icon-cut, #5E37A6)" stroke-width="2" d="M13.5 20v-7h2.2l.4-2.6h-2.6V8.8c0-.8.3-1.3 1.4-1.3h1.3V5.2c-.3 0-1.1-.1-2-.1-2.1 0-3.5 1.3-3.5 3.5v1.8H8.5V13h2.2v7"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.3 2.5 2 4 4.5 4.2"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="currentColor" stroke="none"/><path fill="var(--lm-icon-cut, #5E37A6)" stroke="none" d="m10 9.2 5 2.8-5 2.8z"/>
  {%- endcase -%}
</svg>
