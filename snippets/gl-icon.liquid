{%- comment -%}
  Glow landing inline icons. Usage: {% render 'gl-icon', name: 'truck' %}
  Icons use currentColor, so the color is controlled from CSS / section settings.
{%- endcomment -%}
<svg class="gl-icon gl-icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
    {%- when 'bag' -%}<path d="M5 8h14l1 12H4L5 8Z"/><path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>
    {%- when 'star' -%}<path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.8 6.2.9-4.5 4.4 1.1 6.2L12 17.1l-5.6 3 1.1-6.2L3 9.5l6.2-.9L12 2.8Z"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron-right' -%}<path d="m9 5 7 7-7 7"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.3 2.3 4.1-4.3"/>
    {%- when 'refresh' -%}<path d="M20 11a8 8 0 0 0-14-4.5L4 9M4 13a8 8 0 0 0 14 4.5l2-2.5"/><path d="M4 4v5h5M20 20v-5h-5"/>
    {%- when 'headset' -%}<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.5-1.8 2.5-5 2.5"/>
    {%- when 'leaf' -%}<path d="M20 4C10 4 4.5 9 4.5 15c0 1.6.5 3 1.5 4C12 19 19 15 20 4Z"/><path d="M4 21c2-5 6-8.5 11-11"/>
    {%- when 'drop' -%}<path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.600 6-11 6-11Z"/><path d="M9.500 14.500a2.800 2.800 0 0 0 2.500 2.500"/>
    {%- when 'flask' -%}<path d="M9.500 3h5M10.500 3v6L5 19a1.500 1.500 0 0 0 1.300 2.200h11.400A1.500 1.500 0 0 0 19 19l-5.500-10V3"/><path d="M7.500 15h9"/>
    {%- when 'rabbit' -%}<path d="M9 3c-1.500 2-1.500 5 0 8M14 3c1.500 2 1.500 5 0 8"/><path d="M8 11c-2 1.500-3 4-3 6.500C5 20 7.500 21 12 21s7-1 7-3.500c0-2.500-1-5-3-6.500"/><circle cx="10" cy="15.500" r=".6" fill="currentColor"/><circle cx="14" cy="15.500" r=".6" fill="currentColor"/>
    {%- when 'mail' -%}<rect x="3.500" y="6" width="17" height="12" rx="1.500"/><path d="m4 7 8 6 8-6"/><path d="M8 4.500 12 2l4 2.500"/>
    {%- when 'play' -%}<path fill="currentColor" stroke="none" d="m10 8 6 4-6 4z"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'send' -%}<path d="M21 3 10 14M21 3l-6.500 18-4-7-7-4L21 3Z"/>
    {%- when 'facebook' -%}<path d="M14 21v-8h2.600l.4-3h-3V8.300c0-.9.300-1.500 1.600-1.500H17V4.100c-.3 0-1.200-.1-2.300-.1-2.300 0-3.700 1.400-3.700 3.900V10H8.500v3H11v8"/>
    {%- when 'instagram' -%}<rect x="3.500" y="3.500" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.500a3.500 3.500 0 1 1-3.500-3.500M14 3c.3 2.500 2 4 4.500 4.200"/>
    {%- when 'youtube' -%}<rect x="2.500" y="5.500" width="19" height="13" rx="4"/><path fill="currentColor" stroke="none" d="m10 9.200 5 2.800-5 2.800z"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="m10.500 17 1.500-7M9.500 12.500c-.8-2.500 1-4.500 3-4.500 2 0 3 1.500 2.500 3.200-.4 1.500-1.500 2.300-2.500 2"/>
  {%- endcase -%}
</svg>
