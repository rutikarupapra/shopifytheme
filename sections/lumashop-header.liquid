{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .lm-header {
    {%- if s.bg_color != blank -%}--lm-header-bg: {{ s.bg_color }};{%- endif -%}
    {%- if s.link_color != blank -%}--lm-header-link-color: {{ s.link_color }};{%- endif -%}
    {%- if s.active_color != blank -%}--lm-header-active-color: {{ s.active_color }};{%- endif -%}
    {%- if s.icon_color != blank -%}--lm-header-icon-color: {{ s.icon_color }};{%- endif -%}
    {%- if s.badge_bg != blank -%}--lm-header-badge-bg: {{ s.badge_bg }};{%- endif -%}
    --lm-header-link-size: {{ s.link_size | divided_by: 10.0 }}rem;
    --lm-header-logo-size: {{ s.logo_size | divided_by: 10.0 }}rem;
    --lm-header-logo-image-width: {{ s.logo_image_width }}px;
    --lm-header-icon-size: {{ s.icon_size }}px;
    --lm-header-padding-y: {{ s.padding_y }}px;
  }
{%- endstyle -%}

<header class="lm-header{% if s.sticky %} lm-header--sticky{% endif %}" data-lm-header>
  <div class="lm-header__inner">
    <a class="lm-header__logo" href="{{ routes.root_url }}">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 600 | image_tag: class: 'lm-header__logo-image', alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {%- if s.show_logo_icon -%}<span class="lm-header__logo-icon">{% render 'lumashop-icon', name: 'bag' %}</span>{%- endif -%}
        <span class="lm-header__logo-text">{{ s.logo_text }}<span class="lm-header__logo-script">{{ s.logo_script_text }}</span></span>
      {%- endif -%}
    </a>

    <nav class="lm-header__nav" id="lm-header-nav" aria-label="Main menu">
      {%- if s.menu != blank and s.menu.links.size > 0 -%}
        <ul class="lm-header__menu">
          {%- for link in s.menu.links -%}
            <li class="lm-header__menu-item{% if link.active or link.child_active %} lm-header__menu-item--active{% endif %}">
              <a class="lm-header__menu-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="lm-header__menu-empty">Select a menu in the section settings.</p>
      {%- endif -%}
    </nav>

    <div class="lm-header__actions">
      {%- if s.show_search -%}
        <a class="lm-header__action lm-header__action--search" href="{{ routes.search_url }}" aria-label="Search">{% render 'lumashop-icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if s.show_account -%}
        <a class="lm-header__action lm-header__action--account" href="{{ routes.account_url }}" aria-label="Account">{% render 'lumashop-icon', name: 'user' %}</a>
      {%- endif -%}
      {%- if s.show_cart -%}
        <a class="lm-header__action lm-header__action--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'lumashop-icon', name: 'cart' %}
          <span class="lm-header__cart-count" data-lm-cart-count{% if cart.item_count == 0 and s.hide_empty_count %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
      <button type="button" class="lm-header__action lm-header__toggle" aria-expanded="false" aria-controls="lm-header-nav" data-lm-nav-toggle aria-label="Menu">
        <span class="lm-header__toggle-open">{% render 'lumashop-icon', name: 'menu' %}</span>
        <span class="lm-header__toggle-close">{% render 'lumashop-icon', name: 'close' %}</span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "LumaShop Header",
  "class": "lm-section-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional, replaces text logo)" },
    { "type": "range", "id": "logo_image_width", "label": "Logo image width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 150 },
    { "type": "checkbox", "id": "show_logo_icon", "label": "Show bag icon before text logo", "default": true },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Luma" },
    { "type": "text", "id": "logo_script_text", "label": "Logo script text", "default": "Shop" },
    { "type": "range", "id": "logo_size", "label": "Logo text size", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 26 },
    { "type": "header", "content": "Menu & icons" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "range", "id": "link_size", "label": "Menu link size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "hide_empty_count", "label": "Hide cart count when cart is empty", "default": false },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors (leave empty to use global LumaShop colors)" },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "link_color", "label": "Menu link" },
    { "type": "color", "id": "active_color", "label": "Active link / underline" },
    { "type": "color", "id": "icon_color", "label": "Icons" },
    { "type": "color", "id": "badge_bg", "label": "Cart count badge" }
  ]
}
{% endschema %}
