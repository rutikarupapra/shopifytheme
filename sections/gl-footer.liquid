{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .gl-footer {
    {%- if s.bg_color != blank -%}--gl-footer-bg: {{ s.bg_color }};{%- endif -%}
    {%- if s.heading_color != blank -%}--gl-footer-heading-color: {{ s.heading_color }};{%- endif -%}
    {%- if s.text_color != blank -%}--gl-footer-text-color: {{ s.text_color }};{%- endif -%}
    {%- if s.line_color != blank -%}--gl-footer-line-color: {{ s.line_color }};{%- endif -%}
    --gl-footer-logo-size: {{ s.logo_size | divided_by: 10.0 }}rem;
    --gl-footer-logo-image-width: {{ s.logo_image_width }}px;
    --gl-footer-heading-size: {{ s.heading_size | divided_by: 10.0 }}rem;
    --gl-footer-text-size: {{ s.text_size | divided_by: 10.0 }}rem;
    --gl-footer-padding-top: {{ s.padding_top }}px;
    --gl-footer-padding-bottom: {{ s.padding_bottom }}px;
  }
{%- endstyle -%}

<footer class="gl-footer">
  <div class="gl-footer__inner">
    <div class="gl-footer__grid">
      <div class="gl-footer__brand">
        <a class="gl-footer__logo" href="{{ routes.root_url }}">
          {%- if s.logo != blank -%}
            {{ s.logo | image_url: width: 600 | image_tag: class: 'gl-footer__logo-image', alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            <span class="gl-footer__logo-mark">{% render 'gl-icon', name: 'leaf' %}</span>
            <span class="gl-footer__logo-text">{{ s.logo_text }}</span>
          {%- endif -%}
        </a>
        {%- if s.tagline != blank -%}<p class="gl-footer__tagline">{{ s.tagline }}</p>{%- endif -%}
        <ul class="gl-footer__social">
          {%- assign socials = 'facebook,instagram,tiktok,youtube,pinterest' | split: ',' -%}
          {%- for name in socials -%}
            {%- assign key = 'social_' | append: name | append: '_link' -%}
            {%- assign url = settings[key] -%}
            {%- if url != blank -%}
              <li><a class="gl-footer__social-link" href="{{ url }}" aria-label="{{ name | capitalize }}" target="_blank" rel="noopener">{% render 'gl-icon', name: name %}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            <div class="gl-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h3 class="gl-footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="gl-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li><a class="gl-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'newsletter' -%}
            <div class="gl-footer__col gl-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h3 class="gl-footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="gl-footer__newsletter-text">{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', class: 'gl-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input class="gl-footer__input" type="email" name="contact[email]" placeholder="{{ block.settings.placeholder | escape }}" aria-label="{{ block.settings.placeholder | escape }}" required autocomplete="email">
                <button class="gl-footer__submit" type="submit" aria-label="Subscribe">{% render 'gl-icon', name: 'send' %}</button>
                {%- if form.posted_successfully? -%}<p class="gl-footer__success">{{ block.settings.success_text }}</p>{%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="gl-footer__bottom">
      <p class="gl-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ s.copyright_text | default: shop.name }}</p>
      {%- if s.legal_menu != blank -%}
        <ul class="gl-footer__legal">
          {%- for link in s.legal_menu.links -%}
            <li><a class="gl-footer__legal-link" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Glow Footer",
  "class": "gl-section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "range", "id": "logo_image_width", "label": "Logo image width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Glowérive" },
    { "type": "textarea", "id": "tagline", "label": "Short description", "default": "Natural skincare crafted with care for glowing, healthy skin." },
    { "type": "text", "id": "copyright_text", "label": "Copyright name (empty = shop name)" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" },
    { "type": "header", "content": "Layout & spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "logo_size", "label": "Logo text size", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "heading_size", "label": "Column heading size", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Colors (leave empty to use global Landing colors)" },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "heading_color", "label": "Headings" },
    { "type": "color", "id": "text_color", "label": "Text & links" },
    { "type": "color", "id": "line_color", "label": "Divider line" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Glow Club" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get 20% off your first order." },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
        { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you for subscribing!" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow Footer",
      "blocks": [
        { "type": "links", "settings": { "heading": "Shop" } },
        { "type": "links", "settings": { "heading": "Help" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
