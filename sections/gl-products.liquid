{%- liquid
  assign s = section.settings
  assign badge_list = s.badges | split: ','
  assign ph_names = 'Hydra Glow Gel Cream|Radiance Boost Serum|Nourishing Night Restorative Cream|Daily UV Defense Sunscreen SPF 50' | split: '|'
  assign ph_prices = '$34.00|$42.00|$38.00|$24.00' | split: '|'
  assign ph_counts = '245|189|312|156' | split: '|'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .gl-products {
    {%- if s.bg_color != blank -%}--gl-prod-bg: {{ s.bg_color }};{%- endif -%}
    {%- if s.heading_color != blank -%}--gl-prod-heading-color: {{ s.heading_color }};{%- endif -%}
    {%- if s.card_bg != blank -%}--gl-prod-card-bg: {{ s.card_bg }};{%- endif -%}
    {%- if s.image_bg != blank -%}--gl-prod-image-bg: {{ s.image_bg }};{%- endif -%}
    {%- if s.name_color != blank -%}--gl-prod-name-color: {{ s.name_color }};{%- endif -%}
    {%- if s.price_color != blank -%}--gl-prod-price-color: {{ s.price_color }};{%- endif -%}
    {%- if s.badge_bg != blank -%}--gl-prod-badge-bg: {{ s.badge_bg }};{%- endif -%}
    {%- if s.badge_color != blank -%}--gl-prod-badge-color: {{ s.badge_color }};{%- endif -%}
    {%- if s.button_bg != blank -%}--gl-prod-button-bg: {{ s.button_bg }};{%- endif -%}
    {%- if s.button_color != blank -%}--gl-prod-button-color: {{ s.button_color }};{%- endif -%}
    --gl-prod-columns: {{ s.columns_desktop }};
    --gl-prod-columns-mobile: {{ s.columns_mobile }};
    --gl-prod-gap: {{ s.gap }}px;
    --gl-prod-ratio: {{ s.image_ratio }};
    --gl-prod-heading-size: {{ s.heading_size | divided_by: 10.0 }}rem;
    --gl-prod-name-size: {{ s.name_size | divided_by: 10.0 }}rem;
    --gl-prod-price-size: {{ s.price_size | divided_by: 10.0 }}rem;
    --gl-prod-padding-top: {{ s.padding_top }}px;
    --gl-prod-padding-bottom: {{ s.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="gl-products">
  <div class="gl-products__inner">
    <div class="gl-products__header">
      <h2 class="gl-products__heading">
        <span class="gl-products__heading-text">{{ s.heading }}</span>
        <span class="gl-products__heading-line" aria-hidden="true"></span>
      </h2>
      {%- if s.button_label != blank -%}
        <a class="gl-products__view-all" href="{{ s.button_link | default: s.collection.url | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>

    <ul class="gl-products__grid">
      {%- if s.collection != blank and s.collection.products.size > 0 -%}
        {%- for product in s.collection.products limit: s.products_to_show -%}
          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
            endif
            assign badge_text = badge_list[forloop.index0] | strip
            if on_sale and badge_text == blank
              assign badge_text = 'SALE'
            endif
            assign rating = product.metafields.reviews.rating.value
          -%}
          <li class="gl-products__item">
            <article class="gl-products__card">
              <div class="gl-products__media">
                {%- if s.show_badge and badge_text != blank -%}<span class="gl-products__badge">{{ badge_text }}</span>{%- endif -%}
                <a class="gl-products__media-link" href="{{ product.url }}" tabindex="-1">
                  {%- if product.featured_media != blank -%}
                    {{ product.featured_media | image_url: width: 600 | image_tag: class: 'gl-products__image', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.title }}
                  {%- else -%}
                    <img class="gl-products__image gl-products__image--placeholder" src="{{ 'gl-ph-product.svg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
                  {%- endif -%}
                </a>
              </div>
              <div class="gl-products__info">
                <h3 class="gl-products__name"><a class="gl-products__name-link" href="{{ product.url }}">{{ product.title }}</a></h3>
                {%- if s.show_rating -%}
                  <div class="gl-products__rating">
                    <span class="gl-products__stars" aria-hidden="true">
                      {%- for i in (1..5) -%}<span class="gl-products__star{% if rating != blank and i > rating.rating %} is-empty{% endif %}">{% render 'gl-icon', name: 'star' %}</span>{%- endfor -%}
                    </span>
                    {%- if product.metafields.reviews.rating_count != blank -%}<span class="gl-products__rating-count">({{ product.metafields.reviews.rating_count }})</span>{%- endif -%}
                  </div>
                {%- endif -%}
                <p class="gl-products__price">
                  <span class="gl-products__price-current">{{ product.price | money }}</span>
                  {%- if on_sale -%}<s class="gl-products__price-old">{{ product.compare_at_price | money }}</s>{%- endif -%}
                </p>
                <div class="gl-products__actions">
                  {%- if product.available and product.variants.size == 1 -%}
                    {%- form 'product', product, class: 'gl-products__form' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="gl-products__button"><span>{{ s.add_label }}</span>{% render 'gl-icon', name: 'chevron-right' %}</button>
                    {%- endform -%}
                  {%- else -%}
                    <a class="gl-products__button" href="{{ product.url }}"><span>{% if product.available %}{{ s.choose_label }}{% else %}{{ s.sold_out_label }}{% endif %}</span>{% render 'gl-icon', name: 'chevron-right' %}</a>
                  {%- endif -%}
                  {%- if s.show_wishlist -%}
                    <button type="button" class="gl-products__wishlist" data-gl-wishlist="{{ product.id }}" aria-pressed="false" aria-label="Wishlist">{% render 'gl-icon', name: 'heart' %}</button>
                  {%- endif -%}
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (0..3) -%}
          <li class="gl-products__item">
            <article class="gl-products__card">
              <div class="gl-products__media">
                {%- if s.show_badge and badge_list[i] != blank -%}<span class="gl-products__badge">{{ badge_list[i] | strip }}</span>{%- endif -%}
                <a class="gl-products__media-link" href="#" tabindex="-1">
                  <img class="gl-products__image gl-products__image--placeholder" src="{{ 'gl-ph-product.svg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
                </a>
              </div>
              <div class="gl-products__info">
                <h3 class="gl-products__name"><a class="gl-products__name-link" href="#">{{ ph_names[i] }}</a></h3>
                {%- if s.show_rating -%}
                  <div class="gl-products__rating">
                    <span class="gl-products__stars" aria-hidden="true">{%- for k in (1..5) -%}<span class="gl-products__star">{% render 'gl-icon', name: 'star' %}</span>{%- endfor -%}</span>
                    <span class="gl-products__rating-count">({{ ph_counts[i] }})</span>
                  </div>
                {%- endif -%}
                <p class="gl-products__price"><span class="gl-products__price-current">{{ ph_prices[i] }}</span></p>
                <div class="gl-products__actions">
                  <a class="gl-products__button" href="#"><span>{{ s.add_label }}</span>{% render 'gl-icon', name: 'chevron-right' %}</a>
                  {%- if s.show_wishlist -%}
                    <button type="button" class="gl-products__wishlist" data-gl-wishlist="ph-{{ i }}" aria-pressed="false" aria-label="Wishlist">{% render 'gl-icon', name: 'heart' %}</button>
                  {%- endif -%}
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Glow Products",
  "tag": "section",
  "class": "gl-section-products",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FEATURED PRODUCTS" },
    { "type": "text", "id": "button_label", "label": "'View all' label (empty = hide)", "default": "VIEW ALL" },
    { "type": "url", "id": "button_link", "label": "'View all' link (empty = collection)" },
    { "type": "collection", "id": "collection", "label": "Collection (empty = 4 demo placeholders)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "badges", "label": "Badge labels in order (comma separated)", "default": "BEST SELLER, NEW, LIMITED, SALE" },
    { "type": "checkbox", "id": "show_badge", "label": "Show badges", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist heart", "default": true },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "ADD TO CART" },
    { "type": "text", "id": "choose_label", "label": "Choose options label", "default": "CHOOSE OPTIONS" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "header", "content": "Layout & spacing" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "4 / 5", "label": "Portrait" }], "default": "4 / 3" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "name_size", "label": "Product name size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 11, "max": 26, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors (leave empty to use global Landing colors)" },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "heading_color", "label": "Heading" },
    { "type": "color", "id": "card_bg", "label": "Card background" },
    { "type": "color", "id": "image_bg", "label": "Image background" },
    { "type": "color", "id": "name_color", "label": "Product name" },
    { "type": "color", "id": "price_color", "label": "Price" },
    { "type": "color", "id": "badge_bg", "label": "Badge background" },
    { "type": "color", "id": "badge_color", "label": "Badge text" },
    { "type": "color", "id": "button_bg", "label": "Button background" },
    { "type": "color", "id": "button_color", "label": "Button text" }
  ],
  "presets": [{ "name": "Glow Products" }]
}
{% endschema %}
